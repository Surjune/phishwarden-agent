# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Before run: leave both pointing at the raw MCP server (the default).
# After run: point them at the AgntID runtime proxy URL(s).
TRIAGE_MCP_URL=http://127.0.0.1:8000/mcp
RESPONSE_MCP_URL=http://127.0.0.1:8000/mcp

# Dashboard "after" run: AgntID runtime proxy URLs for each agent.
AGNTID_TRIAGE_MCP_URL=
AGNTID_RESPONSE_MCP_URL=

PHISHWARDEN_MODEL=claude-opus-5-5
